[Unit]
Description=Homelab-Command-Center Dashboard & Server Orchestrator
After=network.target docker.service

[Service]
Type=simple
User=YOUR_LINUX_USER
WorkingDirectory=/opt/Homelab-Command-Center
Environment="PORT=5000"
Environment="HOST=0.0.0.0"
ExecStart=/usr/bin/python3 app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
