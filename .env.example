# Linux Command Center - Environment Configuration Template
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env

# Web Server Configuration
HOST=0.0.0.0
PORT=5000
DEBUG=false

# Networking (Optional: override auto-detected LAN IP)
# PRIMARY_IP=192.168.1.100

# File Paths & Directories (Defaults to local subdirectories if unset)
# SCRIPTS_DIR=./scripts
# SCREENSHOTS_DIR=./screenshots
# BACKUPS_DIR=./backups
# STORAGE_BASE=/mnt/storage

# AI & Automation Binaries (Auto-detected from $PATH if unset)
# OPENCODE_BIN=/usr/local/bin/opencode
# OLLAMA_BIN=/usr/local/bin/ollama
# OLLAMA_URL=http://localhost:11434

# AdGuard Home / DNS Integration (Optional)
# ADGUARD_QUERYLOG=/opt/AdGuardHome/data/querylog.json
